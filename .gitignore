# --- secrets: never commit ---
.env
credentials.json
token.json
secrets/

# --- Claude Code / editor artifacts ---
.claude/
.vscode/
.idea/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

